# Site URL (used in emails, sitemap, SEO)
NEXT_PUBLIC_SITE_URL=https://phokentish.vercel.app

# Supabase (recommended for production — otherwise local JSON is used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional but recommended for server-side admin (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Email — choose Resend OR SMTP (SMTP takes priority when SMTP_HOST is set)
# EMAIL_PROVIDER=smtp

# Option A: Resend
RESEND_API_KEY=
EMAIL_FROM="Pho Kentish <bookings@phokentish.com>"

# Option B: SMTP (Gmail / Google Workspace)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=Phovagrill@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Pho Kentish <Phovagrill@gmail.com>"

# Staff inbox for new-booking alerts
STAFF_NOTIFICATION_EMAIL=Phovagrill@gmail.com

# SMS — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin dashboard password
ADMIN_PASSWORD=change-me

# Cron job auth — generate with: openssl rand -hex 32
CRON_SECRET=

# Reminder timing: "daily" (Vercel Hobby) or "two_hours"
REMINDER_MODE=daily

# Menu AI helper (optional)
OPENAI_API_KEY=
