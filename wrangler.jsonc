{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phokentish",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "4554ebaf04a945bb2314a40821b1b3fe",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "phokentish"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phokentish-db",
      "database_id": "7c5f94d2-9e99-462c-9996-38947fc72994",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://phokentish.duydichdanh.workers.dev"
  }
}
